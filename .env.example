# Copy to .env on each deploy host and set to that host's real addresses.
# Docker Compose auto-loads .env from the project directory.
#
# Without a .env, the compose files fall back to the generic hostnames below,
# which will not resolve on a real network.

# Vector store (Qdrant)
QDRANT_URL=http://vector-host:6333
BACKUP_QDRANT_URL=http://vector-host:6333
QDRANT_URL_ALT=http://vector-host:6333

# OpenAI-compatible embeddings server (e.g. LM Studio, Ollama)
EMBED_URL=http://llm-host:1234/v1
EMBED_URL_ALT=http://llm-host:1234/v1

# Letta agent server
BACKUP_LETTA_URL=http://llm-host:8283

# qdrant-memory MCP endpoint; set to 'off' to disable
CLAUDE_MEMORY_MCP_URL=http://gateway-host:8402/mcp
